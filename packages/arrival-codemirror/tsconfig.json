{
  "extends": ["@here.build/tsconfig/purpose/lib", "@here.build/tsconfig/env/browser"],
  // TYPECHECK program: src incl. `__tests__`, demos, .storybook, root configs.
  // Emit is the separate src-only `tsconfig.build.json`.
  "compilerOptions": {
    // noEmit program: rootDir spans the repo so the shared ../../eslint.arrival.mjs (imported by eslint.config.mjs) is in-bounds.
    "rootDir": "../..",
    "outDir": "./dist",
    "noEmit": true,
    // JS (eslint configs, scripts, fixtures) is part of the program: parsed for typed lint and type-checked.
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "types": [],
    // Demos import the package by its public name (copy-pasteable), mapped to
    // the source so `pnpm typecheck` needs no prior build.
    "paths": {
      "@here.build/arrival-codemirror": ["./src/index.ts"],
      "@here.build/arrival-codemirror/react": ["./src/react/index.ts"]
    }
  },
  "include": ["src/**/*", "demos/**/*", ".storybook/**/*", "*.ts", "*.mjs"],
  "exclude": ["node_modules", "dist"]
}
