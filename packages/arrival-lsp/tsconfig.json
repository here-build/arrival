{
  "extends": [
    "@here.build/tsconfig/purpose/lib",
    "@here.build/tsconfig/env/node"
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  // `*.cases.ts` are bite-guard fixtures (expect-type assertions that import
  // vitest); they are NOT shipped — compiled only by tsconfig.cases.json.
  "exclude": ["node_modules", "dist", "src/__tests__/**/*", "src/**/*.cases.ts"]
}
