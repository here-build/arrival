{
  "name": "@here.build/arrival-type-lens",
  "version": "0.1.0",
  "description": "Scheme\u2192TS type lens \u2014 the shared PRE prelude (branded base types + Dict mapped type + __arr declaration-merge contract) the 34 builtin .d.ts leaves merge into, so arrival programs bite under tsc.",
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./ls-protocol": {
      "types": "./dist/ls-protocol.d.ts",
      "import": "./dist/ls-protocol.js"
    },
    "./ls-client": {
      "types": "./dist/ls-client.d.ts",
      "import": "./dist/ls-client.js"
    },
    "./host-prelude": {
      "types": "./dist/host-prelude.d.ts",
      "import": "./dist/host-prelude.js"
    },
    "./balance": {
      "types": "./dist/balance.d.ts",
      "import": "./dist/balance.js"
    },
    "./virtual-files": {
      "types": "./dist/virtual-files.d.ts",
      "import": "./dist/virtual-files.js"
    },
    "./span-map": {
      "types": "./dist/span-map.d.ts",
      "import": "./dist/span-map.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run generate:bundles && tsc",
    "dev": "tsc --watch",
    "generate:bundles": "node scripts/generate-bundles.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "research": "vitest run --config vitest.research.config.ts"
  },
  "dependencies": {
    "@here.build/arrival-chain": "workspace:^",
    "@here.build/arrival-sugarcoat": "workspace:^",
    "@inhuman-tools/mercury": "workspace:^",
    "typescript": "6.0.2"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "tslib": "2.8.1",
    "vitest": "4.1.0"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
