{
  "name": "@here.build/arrival-type-lens",
  "version": "0.1.0",
  "description": "Scheme→TS type lens — the shared PRE prelude (branded base types + Dict mapped type + __arr declaration-merge contract) the 34 builtin .d.ts leaves merge into, so arrival programs bite under tsc.",
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run generate:bundles && tsc",
    "dev": "tsc --watch",
    "generate:bundles": "node scripts/generate-bundles.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@here.build/arrival-chain-view": "workspace:^",
    "typescript": "6.0.2"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "tslib": "2.8.1",
    "vitest": "4.1.0"
  }
}
