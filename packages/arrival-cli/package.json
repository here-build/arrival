{
  "name": "@inhuman.tools/arrival-cli",
  "version": "0.9.0",
  "description": "The arrival command — run programs, REPL, and static-check from the terminal. `arrival run file.scm` (whole-program diagnostics, then execute with (require …) rooted at the file's dir), `arrival repl` (persistent-scope session, teaching-door errors), `arrival check file.scm` (the eslint-style pass, no execution).",
  "keywords": [
    "arrival",
    "scheme",
    "cli",
    "repl"
  ],
  "license": "MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/here-build/arrival#readme",
  "bugs": {
    "url": "https://github.com/here-build/arrival/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/arrival.git",
    "directory": "packages/arrival-cli"
  },
  "type": "module",
  "bin": {
    "arrival": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@inhuman.tools/arrival": "workspace:^",
    "@inhuman.tools/arrival-modules": "workspace:^",
    "@inhuman.tools/arrival-serializer": "workspace:^",
    "@inhuman.tools/arrival-sugarcoat": "workspace:^",
    "@inhuman.tools/mcp-substrate": "workspace:^",
    "chalk": "5.6.2",
    "ink": "7.1.0",
    "react": "19.2.0",
    "react-devtools-core": "7.0.1"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "0.9.0",
    "@here.build/tsconfig": "0.9.0",
    "@types/node": "24.0.0",
    "@types/react": "19.2.14",
    "eslint": "9.39.2",
    "ink-testing-library": "4.0.0",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "zod": "4.3.6"
  }
}
