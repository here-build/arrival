{
  "name": "@inhuman.tools/arrival-sampler",
  "version": "0.1.0",
  "description": "EXPERIMENTAL proof-of-concept, not production: minimal-intervention constrained-decoding kernel for arrival (pure static sampler with structural + Σ gates) + node-llama-cpp on-demand wiring exposing OpenAI-compatible API + BFCL harness integration points. Exists to make a point (see PAPER.md); API unstable.",
  "keywords": [
    "experimental",
    "proof-of-concept",
    "constrained-decoding",
    "grammar-constrained-generation",
    "structured-generation",
    "logit-masking",
    "minimal-intervention",
    "tool-calling",
    "function-calling",
    "scheme",
    "arrival"
  ],
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./typed-scanner-async": {
      "types": "./dist/typed-scanner-async.d.ts",
      "import": "./dist/typed-scanner-async.js"
    },
    "./decode": {
      "node": {
        "types": "./dist-server/runners/local/server-generate.d.ts",
        "import": "./dist-server/runners/local/server-generate.js"
      }
    },
    "./server": {
      "node": {
        "types": "./dist-server/runners/server/index.d.ts",
        "import": "./dist-server/runners/server/index.js"
      }
    },
    "./palettes": {
      "node": {
        "types": "./dist-server/runners/palettes.d.ts",
        "import": "./dist-server/runners/palettes.js"
      }
    },
    "./rosters.json": "./rosters.json",
    "./lmstudio": {
      "node": {
        "types": "./dist-server/runners/gguf/lmstudio.d.ts",
        "import": "./dist-server/runners/gguf/lmstudio.js"
      }
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "arrival-openai-server": "./dist-server/runners/server/cli.js"
  },
  "files": [
    "dist",
    "dist-server",
    "rosters.json",
    "roster-resolution.json",
    "src",
    "PAPER.md",
    "EXPERIMENTS-AND-RESEARCH-INVENTORY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "custdev": "vitest run --config vitest.custdev.config.ts",
    "test:llm-fast": "LLM_ROSTER=fast vitest run --config vitest.custdev.config.ts",
    "test:llm-full": "LLM_ROSTER=full vitest run --config vitest.custdev.config.ts",
    "test:llm-extended": "LLM_ROSTER=extended vitest run --config vitest.custdev.config.ts",
    "test:llm-all": "LLM_ROSTER=all vitest run --config vitest.custdev.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "research": "vitest run --config vitest.research.config.ts",
    "benchmarks": "vitest run --config vitest.benchmarks.config.ts",
    "smoke": "tsx src/runners/server/smoke.mjs"
  },
  "dependencies": {
    "@inhuman.tools/arrival": "workspace:^",
    "dedent": "1.7.2",
    "tiny-invariant": "1.3.3"
  },
  "optionalDependencies": {
    "node-llama-cpp": "3.18.1"
  },
  "devDependencies": {
    "@inhuman.tools/arrival-lsp": "workspace:^",
    "@here.build/eslint-configs": "0.9.0",
    "@here.build/tsconfig": "0.9.0",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  }
}
