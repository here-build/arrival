{
  "extends": [
    "@here.build/tsconfig/purpose/lib",
    "@here.build/tsconfig/env/browser-widespread"
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "types": []
  },
  // The `.` entry is index.ts; tsc compiles its transitive closure (the pure kernel: mask-compiler,
  // oracle-types, select-constrained-step, typed-scanner, step-explain, force-emit + gates) and nothing else.
  // Narrowing by ENTRY rather than excluding dirs is self-maintaining: research, tests, harness, and node-only
  // modules are unreachable from this entry. The `./server` + `./decode` subpaths build separately via tsconfig.server.json.
  "include": ["src/index.ts"]
}
