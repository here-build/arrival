{
  "name": "@inhuman.tools/arrival-mercury",
  "version": "0.9.0",
  "description": "Arrival Mercury instance — scheme→TS compiler (SchemeSemanticModel + Residual + ts.factory) and differential oracle (interpreter ≡ compiled). Paradigm: docs/foundations/mercury/mercury-as-paradigm.md.",
  "keywords": [
    "arrival",
    "mercury",
    "compiler",
    "oracle",
    "semantic-model"
  ],
  "homepage": "https://github.com/here-build/arrival#readme",
  "bugs": {
    "url": "https://github.com/here-build/arrival/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/arrival.git",
    "directory": "packages/arrival-mercury"
  },
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./circuit": {
      "types": "./dist/circuit.d.ts",
      "default": "./dist/circuit.js"
    },
    "./front": {
      "types": "./dist/front/index.d.ts",
      "default": "./dist/front/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/__stories__",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc --build --force",
    "test": "vitest run",
    "benchmarks": "vitest run --config vitest.benchmarks.config.ts",
    "typecheck": "tsc --noEmit && pnpm run check:stories",
    "check:stories": "tsc -p tsconfig.stories.json --noEmit",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@inhuman.tools/arrival": "workspace:^",
    "@here.build/lexical-namer": "workspace:^",
    "@inhuman.tools/arrival-run": "workspace:^",
    "@inhuman.tools/arrival-type-lens": "workspace:^",
    "pluralize": "8.0.0",
    "tsx": "4.22.4",
    "typescript": "6.0.2",
    "yaml": "2.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@storybook/react-vite": "^10.0.0",
    "@types/node": "24.0.0",
    "@types/pluralize": "0.0.33",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "elkjs": "0.11.1",
    "eslint": "9.39.2",
    "fast-check": "4.8.0",
    "mermaid": "11.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "storybook": "^10.0.0",
    "vite": "7.2.7",
    "vitest": "4.1.0"
  }
}
