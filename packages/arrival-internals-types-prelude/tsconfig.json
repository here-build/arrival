{
  "extends": ["@here.build/tsconfig/purpose/lib", "@here.build/tsconfig/env/node"],
  "compilerOptions": {
    // noEmit program: rootDir spans the repo so the shared ../../eslint.arrival.mjs (imported by eslint.config.mjs) is in-bounds.
    "rootDir": "../..",
    "outDir": "./dist",
    "noEmit": true,
    // JS (eslint configs, scripts, fixtures) is part of the program: parsed for typed lint and type-checked.
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"]
  },
  // TYPECHECK program: src incl. `__tests__` + root configs (emit is `tsconfig.build.json`).
  "include": ["src/**/*", "*.ts", "*.mjs"],
  // `*.cases.ts` are bite-guard fixtures (expect-type assertions that import
  // vitest); they are NOT shipped — compiled only by tsconfig.cases.json. The
  // reference below routes an opened cases file to that project in the editor, so
  // it resolves ambient builtins / brands instead of erroring in an inferred
  // project. Plain `tsc` (this build) ignores references, so cases stay out of dist.
  "exclude": ["node_modules", "dist", "src/**/*.cases.ts"],
  "references": [{ "path": "./tsconfig.cases.json" }]
}
