{
  // Narrow program for the `*.test-d.ts` TYPE-TESTS, run under `vitest --typecheck`
  // (see `vitest.typecheck.config.ts`): vitest's tsc pass runs the `expectTypeOf` assertions and
  // needs a program of ONLY those files. `tsconfig.json` (the all-files `tsc --noEmit` gate) also
  // compiles them, so a type error in a proof fails both gates.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/__tests__/**/*.test-d.ts"],
  "exclude": ["node_modules", "dist"]
}
