{
  "name": "@here.build/arrival",
  "version": "0.1.0",
  "description": "R7RS-subset Scheme interpreter for AI-agent constraint-based execution — transparent provenance, capability sandbox, JS membrane",
  "keywords": [
    "scheme",
    "lisp",
    "lips",
    "interpreter",
    "sandbox",
    "s-expressions"
  ],
  "homepage": "https://github.com/here-build/foundation#readme",
  "bugs": {
    "url": "https://github.com/here-build/foundation/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/foundation.git",
    "directory": "arrival/arrival"
  },
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./oracle": {
      "types": "./dist/oracle/index.d.ts",
      "import": "./dist/oracle/index.js"
    },
    "./env": {
      "types": "./dist/common/kernel.d.ts",
      "default": "./dist/common/kernel.js"
    },
    "./capability": {
      "types": "./dist/common/capability.d.ts",
      "default": "./dist/common/capability.js"
    },
    "./resources": {
      "types": "./dist/common/resources.d.ts",
      "default": "./dist/common/resources.js"
    },
    "./scheme-env": {
      "types": "./dist/common/scheme-env.d.ts",
      "default": "./dist/common/scheme-env.js"
    },
    "./symbol": {
      "types": "./dist/common/symbol.d.ts",
      "default": "./dist/common/symbol.js"
    },
    "./scheme-zod": {
      "types": "./dist/common/scheme-zod.d.ts",
      "default": "./dist/common/scheme-zod.js"
    },
    "./schema-tag": {
      "types": "./dist/common/schema-tag.d.ts",
      "default": "./dist/common/schema-tag.js"
    },
    "./attestation": {
      "types": "./dist/values/attestation.d.ts",
      "default": "./dist/values/attestation.js"
    },
    "./type-layer": {
      "types": "./dist/type-layer/index.d.ts",
      "default": "./dist/type-layer/index.js"
    },
    "./srfi": {
      "types": "./dist/env/srfi/index.d.ts",
      "default": "./dist/env/srfi/index.js"
    },
    "./overridable": {
      "types": "./dist/env/overridable.d.ts",
      "default": "./dist/env/overridable.js"
    },
    "./schema": {
      "types": "./dist/env/schema.d.ts",
      "default": "./dist/env/schema.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/*.test.*",
    "!**/*.test-d.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-d": "vitest run --config vitest.typecheck.config.ts",
    "benchmarks": "vitest run --config vitest.benchmarks.config.ts",
    "typecheck": "tsc --noEmit && vitest run --config vitest.typecheck.config.ts"
  },
  "dependencies": {
    "@here.build/arrival-env": "workspace:^",
    "@here.build/arrival-sweet": "workspace:^",
    "@here.build/error-invariant": "workspace:^",
    "@here.build/collections": "workspace:^",
    "fantasy-land": "5.0.1",
    "fold-case": "1.0.0",
    "tiny-invariant": "1.3.3",
    "unicode-properties": "1.4.1",
    "zod": "4.3.6",
    "zod-to-ts": "2.1.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "fast-check": "4.8.0",
    "globals": "17.3.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  }
}
