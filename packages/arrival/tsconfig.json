{
  "extends": ["@here.build/tsconfig/purpose/lib", "@here.build/tsconfig/env/browser"],
  "compilerOptions": {
    // noEmit program: rootDir spans the repo so the shared ../../eslint.arrival.mjs (imported by eslint.config.mjs) is in-bounds.
    "rootDir": "../..",
    "outDir": "./dist",
    "noEmit": true,
    // JS (eslint configs, scripts, fixtures) is part of the program: parsed for typed lint and type-checked.
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
    // noImplicitAny override removed (was 9f7a8aaf6): TS 6.0.2 (installed) infers
    // implicit-any more aggressively than the version the lock was authored
    // against, so `noImplicitAny: true` surfaced ~260 pre-existing implicit-anys
    // across heritage-origin files and broke the everyday tsc/build gate. Inherit
    // the shared lib config's `noImplicitAny: false` (still `strict: true`).
  },
  // TYPECHECK program: EVERY TS file in the package — src incl. `__tests__`, `*.test-d.ts`,
  // `__benchmarks__`, `__experiments__`, `__research__`, `__visual__`, and the root
  // `*.ts` configs. Emit is the separate src-only `tsconfig.build.json`.
  "include": ["src/**/*", "*.ts", "*.mjs", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
