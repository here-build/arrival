{
  "name": "@inhuman.tools/arrival-mcp-do",
  "version": "0.9.0",
  "description": "Cloudflare Durable Object shell for arrival-mcp sessions — abstract DO-per-session runner (transport hosting, handshake replay, decomposed SessionRunState storage, TTL reaper, call serialization). Products extend and supply their capability plane; no product semantics here.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "durable-objects",
    "cloudflare-workers"
  ],
  "homepage": "https://github.com/here-build/arrival#readme",
  "bugs": {
    "url": "https://github.com/here-build/arrival/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/arrival.git",
    "directory": "packages/arrival-mcp-do"
  },
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inhuman.tools/arrival-mcp": "workspace:^",
    "@inhuman.tools/mcp-substrate": "workspace:^",
    "@modelcontextprotocol/sdk": "1.26.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250803.0",
    "@here.build/eslint-configs": "0.9.0",
    "@here.build/tsconfig": "0.9.0",
    "eslint": "9.39.2",
    "typescript": "6.0.2"
  }
}
