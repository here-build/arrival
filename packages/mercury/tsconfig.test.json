{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  // fixtures/ holds golden REFERENCE output for an external consumer's project
  // (imports @langchain/core, ./_llm.js — none of which exist in this workspace
  // on purpose) — never meant to compile standalone here.
  //
  // conformance/.tmp/ is the W2 harness's SCRATCH directory (run-compiled.ts):
  // generated `.run.ts` files written and executed (via `tsx`) at test time, never
  // committed (see conformance/.gitignore) — not source, so not type-checked here.
  //
  // conformance/.tmp-strict/ is the W3 strict gate's sibling scratch
  // (strict-emit.test.ts): the SAME artifacts, type-checked by the test's own
  // in-process `tsc --strict` program (that's the point) — excluded here so the
  // package typecheck doesn't double-report what the gate owns.
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__/fixtures/**/*",
    "src/__tests__/conformance/.tmp/**/*",
    "src/__tests__/conformance/.tmp-strict/**/*"
  ]
}
