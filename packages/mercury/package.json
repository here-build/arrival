{
  "name": "@inhuman.tools/mercury",
  "version": "0.9.0",
  "description": "DEPRECATED — legacy string-pipeline predecessor of the arrival Mercury instance (@inhuman.tools/arrival-mercury). Dissolving into the inhuman CLI. Do not add features.",
  "homepage": "https://github.com/here-build/arrival#readme",
  "bugs": {
    "url": "https://github.com/here-build/arrival/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/arrival.git",
    "directory": "packages/mercury"
  },
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./types-emit": {
      "types": "./dist/types-emit.d.ts",
      "import": "./dist/types-emit.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "vitest run src/__tests__/conformance",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@inhuman.tools/arrival-sugarcoat": "workspace:^",
    "@here.build/lexical-namer": "workspace:^",
    "@typescript-eslint/parser": "8.55.0",
    "dotprompt": "1.1.2",
    "eslint": "9.39.2",
    "pluralize": "8.0.0",
    "prettier": "3.8.1",
    "tiny-invariant": "1.3.3"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "2.0.48",
    "@inhuman.tools/arrival-run": "workspace:^",
    "@here.build/eslint-configs": "workspace:^",
    "@inhuman.tools/llm-plane": "workspace:^",
    "@inhuman.tools/llm-plane-protocol": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@langchain/core": "1.1.48",
    "@langchain/openai": "1.4.7",
    "@types/node": "24.0.0",
    "@types/pluralize": "0.0.33",
    "ai": "6.0.201",
    "tslib": "2.8.1",
    "tsx": "4.22.4",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "zod": "4.3.6"
  }
}
