{
  "name": "@inhuman.tools/arrival-mercury-oracle",
  "version": "0.9.0",
  "description": "Differential oracle for arrival-mercury — the interpreter ≡ compiled agreement harness (compile → tsx-import → run), corpus runner, and error classifier. Node/CI only: owns the `tsx` runtime dependency the compiler must not carry.",
  "homepage": "https://github.com/here-build/arrival#readme",
  "bugs": {
    "url": "https://github.com/here-build/arrival/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/arrival.git",
    "directory": "packages/arrival-mercury-oracle"
  },
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc --build --force",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@inhuman.tools/arrival": "workspace:^",
    "@inhuman.tools/arrival-mercury": "workspace:^",
    "tsx": "4.22.4",
    "typescript": "6.0.2"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "0.9.0",
    "@here.build/tsconfig": "0.9.0",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "fast-check": "4.8.0",
    "vitest": "4.1.0"
  }
}
