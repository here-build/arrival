{
  "name": "@here.build/editor-theme",
  "version": "0.9.0",
  "description": "Redistributable editor theme: self-hosted fonts (JetBrains Mono for WRITING, Monaspace Argon/Krypton for READING) + the H-K-compensated Darcula syntax theme + the overlay chrome for CodeMirror. No CDN, no Google Fonts — the fonts ship in the package (OFL).",
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/here-build/arrival#readme",
  "bugs": {
    "url": "https://github.com/here-build/arrival/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/arrival.git",
    "directory": "packages/editor-theme"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/**/*",
    "src/**/*",
    "OFL-JetBrainsMono.txt",
    "LICENSE-Monaspace.txt",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.0",
    "@lezer/highlight": "1.2.1"
  },
  "devDependencies": {
    "@here.build/tsconfig": "workspace:^",
    "tslib": "2.8.1",
    "typescript": "6.0.2"
  }
}
