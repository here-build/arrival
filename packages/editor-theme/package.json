{
  "name": "@here.build/editor-theme",
  "version": "0.9.0",
  "description": "Hermetic CodeMirror 6 look: self-hosted fonts (JetBrains Mono writing / Monaspace reading) + H-K-compensated Darcula + full overlay/form/mark chrome. No CDN.",
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/here-build/arrival#readme",
  "bugs": {
    "url": "https://github.com/here-build/arrival/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/arrival.git",
    "directory": "packages/editor-theme"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/**/*",
    "src/**/*",
    "OFL-JetBrainsMono.txt",
    "LICENSE-Monaspace.txt",
    "README.md",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/stories/**",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6012",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/language": "6.12.3",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.0",
    "@lezer/highlight": "1.2.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lint": "6.9.5",
    "@here.build/tsconfig": "workspace:^",
    "@storybook/react": "10.3.3",
    "@storybook/react-vite": "10.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "storybook": "10.3.3",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vite": "7.2.7"
  }
}
