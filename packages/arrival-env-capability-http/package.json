{
  "name": "@inhuman.tools/arrival-env-capability-http",
  "version": "0.1.0",
  "description": "The (http/get)/(http/post) capability pack: the HttpEffect intent descriptor, the narrow HttpEffectResolver seam (the program names a label; the host binds credential + endpoint host-side), the inert-by-default guard, and the arrival/http EnvCapability.",
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inhuman.tools/arrival": "workspace:^",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/arrival.git",
    "directory": "packages/arrival-env-capability-http"
  },
  "homepage": "https://github.com/here-build/arrival#readme",
  "bugs": {
    "url": "https://github.com/here-build/arrival/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
