{
  "extends": "@here.build/tsconfig/library.json",
  "compilerOptions": {
    "lib": [
      "ES2024",
      "esnext"
    ],
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/__tests__/**/*"
  ]
}
